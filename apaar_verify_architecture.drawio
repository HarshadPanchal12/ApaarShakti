        <!-- Storage 4A: Database (Green #138808) -->
        <mxCell id="c4_pg" value="&lt;div style=&quot;padding:6px;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:38px;vertical-align:top;&quot;&gt;&lt;img src=&quot;https://cdn-icons-png.flaticon.com/512/2152/2152539.png&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#14532D;&quot;&gt;PostgreSQL Master Store&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#138808;color:#FFFFFF;font-size:9.5px;font-weight:700;padding:2px 8px;border-radius:10px;&quot;&gt;SUPABASE POSTGRESQL &amp;bull; RLS ACTIVE&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11.5px;color:#1A1A2E;line-height:1.45;margin-top:8px;&quot;&gt;&amp;bull; &lt;b&gt;Enrolments Table:&lt;/b&gt; Fernet AES encrypted student records&lt;br/&gt;&amp;bull; &lt;b&gt;National Master:&lt;/b&gt; APAAR registry &amp;amp; approved intake quotas&lt;br/&gt;&amp;bull; Row Level Security (&lt;b&gt;RLS&lt;/b&gt;) prevents cross-college unauthorized reads&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#138808;strokeWidth=1.5;arcSize=8;shadow=1;align=left;" vertex="1" parent="tier4_zone">
          <mxGeometry x="30" y="40" width="440" height="105" as="geometry" />
        </mxCell>

        <!-- Storage 4B: Hash Chain Ledger (AICTE Navy #003087) -->
        <mxCell id="c4_ledger" value="&lt;div style=&quot;padding:6px;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:38px;vertical-align:top;&quot;&gt;&lt;img src=&quot;https://cdn-icons-png.flaticon.com/512/942/942751.png&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#003087;&quot;&gt;Forensic SHA-256 Hash Ledger&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#003087;color:#FFFFFF;font-size:9.5px;font-weight:700;padding:2px 8px;border-radius:10px;&quot;&gt;IMMUTABLE LEDGER &amp;bull; ZERO GAS COSTS&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11.5px;color:#1A1A2E;line-height:1.45;margin-top:8px;&quot;&gt;&amp;bull; Every access &amp;amp; triage appends a cryptographically linked row:&lt;br/&gt;&lt;code style=&quot;background:#F0F4FF;padding:2px 6px;border-radius:4px;font-weight:700;color:#003087;font-size:11px;&quot;&gt;row_hash = SHA256(prev_hash + actor + action + res)&lt;/code&gt;&lt;br/&gt;&amp;bull; Mathematical guarantee against direct SQL database tampering&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#003087;strokeWidth=1.5;arcSize=8;shadow=1;align=left;" vertex="1" parent="tier4_zone">
          <mxGeometry x="520" y="40" width="440" height="105" as="geometry" />
