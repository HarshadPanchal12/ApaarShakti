        <!-- Engine 3A: 14 Rules (Saffron #FF6B00) -->
        <mxCell id="c3_engine14" value="&lt;div style=&quot;padding:6px;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:38px;vertical-align:top;&quot;&gt;&lt;img src=&quot;https://cdn-icons-png.flaticon.com/512/2103/2103633.png&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#C2410C;&quot;&gt;14-Rule Autonomous Engine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#FF6B00;color:#FFFFFF;font-size:9.5px;font-weight:700;padding:2px 8px;border-radius:10px;&quot;&gt;100% DETERMINISTIC &amp;bull; &amp;lt; 60ms EXECUTION&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11.5px;color:#431407;line-height:1.5;margin-top:8px;&quot;&gt;&amp;bull; &lt;b&gt;Format:&lt;/b&gt; Strict 12-digit numeric APAAR validation&lt;br/&gt;&amp;bull; &lt;b&gt;Registry Match:&lt;/b&gt; National student master verification&lt;br/&gt;&amp;bull; &lt;b&gt;Fuzzy NLP:&lt;/b&gt; 80% Gestalt similarity on Name &amp;amp; DOB&lt;br/&gt;&amp;bull; &lt;b&gt;Ghost Check:&lt;/b&gt; Multi-institution duplicate enrolments&lt;br/&gt;&amp;bull; &lt;b&gt;Intake Cap:&lt;/b&gt; AICTE Approval Handbook ceiling bounds&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FF6B00;strokeWidth=2;arcSize=8;shadow=1;align=left;" vertex="1" parent="tier3_zone">
          <mxGeometry x="30" y="40" width="440" height="150" as="geometry" />
        </mxCell>

        <!-- Engine 3B: Cryptography (Ashoka Green #138808) -->
        <mxCell id="c3_crypto" value="&lt;div style=&quot;padding:6px;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:38px;vertical-align:top;&quot;&gt;&lt;img src=&quot;https://cdn-icons-png.flaticon.com/512/2092/2092663.png&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#14532D;&quot;&gt;Asymmetric Crypto &amp;amp; PII Shield&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#138808;color:#FFFFFF;font-size:9.5px;font-weight:700;padding:2px 8px;border-radius:10px;&quot;&gt;PYNACL &amp;bull; ED25519 &amp;bull; FERNET AES-128&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11.5px;color:#064E3B;line-height:1.5;margin-top:8px;&quot;&gt;&amp;bull; &lt;b&gt;Ed25519 Signing:&lt;/b&gt; Private key signs payload; verifiable offline&lt;br/&gt;&amp;bull; &lt;b&gt;Envelope Encryption:&lt;/b&gt; Student PII encrypted with Fernet AES-128&lt;br/&gt;&amp;bull; &lt;b&gt;Degree QR Footer:&lt;/b&gt; Embeds cryptographic signature block&lt;br/&gt;&amp;bull; &lt;b&gt;Zero-Knowledge Proof:&lt;/b&gt; Validates status with 0 PII leak&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#138808;strokeWidth=2;arcSize=8;shadow=1;align=left;" vertex="1" parent="tier3_zone">
          <mxGeometry x="520" y="40" width="440" height="150" as="geometry" />
        </mxCell>

        <!-- Engine 3C: Anomaly Detection (AICTE Navy #003087) -->
        <mxCell id="c3_anomaly" value="&lt;div style=&quot;padding:6px;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:38px;vertical-align:top;&quot;&gt;&lt;img src=&quot;https://cdn-icons-png.flaticon.com/512/8637/8637106.png&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#003087;&quot;&gt;Explainable Statistical AI&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#003087;color:#FFFFFF;font-size:9.5px;font-weight:700;padding:2px 8px;border-radius:10px;&quot;&gt;PEER Z-SCORE &amp;bull; QUOTA SPIKE VECTORS&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11.5px;color:#1E3A8A;line-height:1.5;margin-top:8px;&quot;&gt;&amp;bull; &lt;b&gt;Peer Z-Score Engine:&lt;/b&gt; Evaluates regional fill deviations (&lt;b&gt;Z &amp;gt; 2.0&lt;/b&gt;)&lt;br/&gt;&amp;bull; &lt;b&gt;Quota Spike Detection:&lt;/b&gt; Alerts if high-fee category &amp;gt; 15% ceiling&lt;br/&gt;&amp;bull; &lt;b&gt;Plain English Justifications:&lt;/b&gt; 100% legally defensible&lt;br/&gt;&amp;bull; Closed-loop interactive triage for officer review &amp;amp; waiver&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#003087;strokeWidth=2;arcSize=8;shadow=1;align=left;" vertex="1" parent="tier3_zone">
          <mxGeometry x="1010" y="40" width="440" height="150" as="geometry" />
