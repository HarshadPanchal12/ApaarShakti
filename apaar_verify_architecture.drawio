        <mxCell id="c2_dispatch" value="&lt;div style=&quot;padding:6px;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:38px;vertical-align:top;&quot;&gt;&lt;img src=&quot;https://cdn-icons-png.flaticon.com/512/337/337946.png&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#9A3412;&quot;&gt;Regulatory Report Dispatcher&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#FF6B00;color:#FFFFFF;font-size:9.5px;font-weight:700;padding:2px 8px;border-radius:10px;&quot;&gt;REPORTLAB PDF &amp;bull; OPENPYXL EXCEL&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11.5px;color:#431407;line-height:1.45;margin-top:8px;&quot;&gt;&amp;bull; &lt;b&gt;Official PDF:&lt;/b&gt; AICTE Letterhead, saturation table &amp;amp; audit seal&lt;br/&gt;&amp;bull; &lt;b&gt;Excel Report:&lt;/b&gt; Multi-institution admission telemetry (.xlsx)&lt;br/&gt;&amp;bull; Fast in-memory generation with zero disk storage footprint&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF6B00;strokeWidth=1.5;arcSize=8;shadow=1;align=left;" vertex="1" parent="tier2_zone">
