        <mxCell id="c2_fastapi" value="&lt;div style=&quot;padding:6px;text-align:center;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;margin-bottom:4px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center;&quot;&gt;&lt;img src=&quot;https://cdn-icons-png.flaticon.com/512/2165/2165004.png&quot; width=&quot;32&quot; height=&quot;32&quot; style=&quot;vertical-align:middle;margin-right:8px;&quot;/&gt;&lt;span style=&quot;font-size:14.5px;font-weight:800;color:#003087;vertical-align:middle;&quot;&gt;FastAPI Asynchronous Gateway&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style=&quot;background:#003087;color:#FFFFFF;font-size:9.5px;font-weight:700;padding:2px 10px;border-radius:10px;&quot;&gt;PYTHON 3.13 &amp;bull; UVICORN ASGI &amp;bull; TLS 1.3&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#003087;margin-top:8px;line-height:1.45;&quot;&gt;Non-blocking async I/O &amp;bull; CORS protection &amp;bull; Stream sanitization&lt;br/&gt;Automated UTF-8 BOM cleaning &amp;bull; Pydantic schema validation&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#003087;strokeWidth=2;arcSize=8;shadow=1;" vertex="1" parent="tier2_zone">
